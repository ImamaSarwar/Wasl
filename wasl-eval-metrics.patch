+
+def test_usage_for_openai_compatible_replies():
+    assert llm._usage("openai_compatible", {"usage": {"prompt_tokens": 7, "completion_tokens": 3}}) == (7, 3)
+    assert llm._usage("gemini", {}) == (0, 0)

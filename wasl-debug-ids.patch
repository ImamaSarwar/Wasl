+def _by_id(text):
+    """'m25' -> the question text from the eval sets; anything else is returned unchanged."""
+    root = Path(__file__).resolve().parent.parent / "eval"
+    for name in ("questions.jsonl", "generated.jsonl"):
+        for line in (root / name).read_text(encoding="utf-8").splitlines():
+            if line.strip():
+                d = json.loads(line)
+                if d["id"] == text:
+                    return d["question"]
+    return text

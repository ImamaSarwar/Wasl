+.root-chips { display: flex; flex-wrap: wrap; gap: 8px; }
+.root-chip { font-family: var(--arabic); font-size: 20px; padding: 2px 16px; color: var(--ink); background: var(--card); border: 1px solid var(--gold-line); border-radius: 999px; cursor: pointer; }
+.root-chip.learned { background: #edf3e8; border-color: #4f7a5a; }
+.root-chip.revise { background: #f8ebe5; border-color: #9a4a3a; }
+.root-chip:hover { box-shadow: 0 0 0 3px rgba(176,138,46,.25); }
+.dash-note { margin: 0; text-align: center; font-size: 12px; color: var(--muted); }
+@media (max-width: 620px) { .stats dt { letter-spacing: .08em; } .rows li { gap: 10px; } .row-root { width: 76px; font-size: 22px; } .dash .breakdown > div { grid-template-columns: 110px 1fr 44px; } .pair-body { grid-template-columns: 1fr; } }

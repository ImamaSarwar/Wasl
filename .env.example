# Copy to .env (never commit .env). The app works without a key (database-only answers);
# with a key, answers are written by the LLM and then checked against the database.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Only for LLM_PROVIDER=openai_compatible (e.g. Groq: https://api.groq.com/openai/v1)
LLM_BASE_URL=

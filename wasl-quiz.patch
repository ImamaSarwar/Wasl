diff --git a/frontend/src/quizStore.js b/frontend/src/quizStore.js
new file mode 100644
index 0000000..c31b358
--- /dev/null
+++ b/frontend/src/quizStore.js
@@ -0,0 +1,48 @@
+// Pure helpers for quiz results (no React, no browser globals), so they can be unit-tested with `npm test`.
+// Results live in the browser's localStorage on this device only: no account, no server.
+// The future dashboard reads this list; scores, learned roots and confused forms can all be derived from it.
+//
+// Stored shape: [{ level, type, kind, root, wordId, answer, chosen, correct, time }, ...]
+
+export const QUIZ_KEY = "wasl.quiz.v1";
+export const MAX_ATTEMPTS = 2000; // oldest are dropped beyond this
+
+const textOf = (q, id) => {
+  const o = q.options.find((x) => x.id === id);
+  return o?.ayah ? `67:${o.ayah}` : o?.text ?? null;
+};
+
+export function makeAttempt(level, q, chosenId, now = new Date()) {
+  return {
+    level,
+    type: q.type,
+    kind: q.kind ?? null,
+    root: q.root,
+    wordId: q.word?.word_id ?? null,
+    answer: textOf(q, q.answer),
+    chosen: textOf(q, chosenId),
+    correct: chosenId === q.answer,
+    time: now.toISOString(),
+  };
+}
+
+/** Never throws: blocked storage or corrupt data gives an empty list. */
+export function loadAttempts(storage) {
+  try {
+    const list = JSON.parse(storage.getItem(QUIZ_KEY) || "[]");
+    return Array.isArray(list) ? list.filter((a) => a && typeof a.correct === "boolean") : [];
+  } catch {
+    return [];
+  }
+}
+
+/** Append one attempt. Returns false if it could not be saved. */
+export function saveAttempt(storage, attempt) {
+  try {
+    const list = [...loadAttempts(storage), attempt].slice(-MAX_ATTEMPTS);
+    storage.setItem(QUIZ_KEY, JSON.stringify(list));
+    return true;
+  } catch {
+    return false;
+  }
+}
diff --git a/frontend/src/quizStore.test.js b/frontend/src/quizStore.test.js
new file mode 100644
index 0000000..3c6513b
--- /dev/null
+++ b/frontend/src/quizStore.test.js
@@ -0,0 +1,41 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { MAX_ATTEMPTS, QUIZ_KEY, loadAttempts, makeAttempt, saveAttempt } from "./quizStore.js";
+
+const fake = (initial) => {
+  const m = new Map(initial ? [[QUIZ_KEY, initial]] : []);
+  return { getItem: (k) => m.get(k) ?? null, setItem: (k, v) => m.set(k, v) };
+};
+const q = {
+  type: "root", root: "خلق", word: { word_id: 11 }, answer: "B",
+  options: [{ id: "A", text: "م ل ك" }, { id: "B", text: "خ ل ق" }],
+};
+
+test("an attempt records what was chosen and whether it was right", () => {
+  const a = makeAttempt("easy", q, "A", new Date("2026-11-26T10:00:00Z"));
+  assert.equal(a.correct, false);
+  assert.equal(a.chosen, "م ل ك");
+  assert.equal(a.answer, "خ ل ق");
+  assert.equal(a.wordId, 11);
+});
+
+test("attempts are appended and read back", () => {
+  const s = fake();
+  assert.equal(saveAttempt(s, makeAttempt("easy", q, "B")), true);
+  saveAttempt(s, makeAttempt("easy", q, "A"));
+  assert.deepEqual(loadAttempts(s).map((a) => a.correct), [true, false]);
+});
+
+test("old attempts are dropped beyond the limit", () => {
+  const s = fake(JSON.stringify(Array(MAX_ATTEMPTS).fill({ correct: true })));
+  saveAttempt(s, { correct: false });
+  const list = loadAttempts(s);
+  assert.equal(list.length, MAX_ATTEMPTS);
+  assert.equal(list.at(-1).correct, false);
+});
+
+test("corrupt or blocked storage never throws", () => {
+  assert.deepEqual(loadAttempts(fake("not json")), []);
+  assert.deepEqual(loadAttempts(null), []);
+  assert.equal(saveAttempt(null, { correct: true }), false);
+});
